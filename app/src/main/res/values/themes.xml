<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Cold-start window only. Everything after the first frame is drawn by
      Compose, and enableEdgeToEdge() in MainActivity picks the correct bar
      contrast for light/dark mode.
    -->
    <style name="Theme.HanTalk" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/surface</item>
    </style>
</resources>
